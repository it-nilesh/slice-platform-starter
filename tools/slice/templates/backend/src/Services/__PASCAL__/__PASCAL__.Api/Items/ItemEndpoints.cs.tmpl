using Microsoft.AspNetCore.Http.HttpResults;

namespace __PASCAL__.Api.Items;

internal static class ItemEndpoints
{
    public static IEndpointRouteBuilder MapItemEndpoints(this IEndpointRouteBuilder app)
    {
        // Routes keep the gateway prefix so NGINX can proxy without rewriting.
        var group = app.MapGroup("/api/__NAME__/items").WithTags("Items");

        group.MapGet("/", GetAll).WithName("GetItems");
        group.MapGet("/{id:guid}", GetById).WithName("GetItemById");
        group.MapPost("/", Create).WithName("CreateItem");

        return app;
    }

    private static async Task<Ok<IReadOnlyList<Item>>> GetAll(IItemRepository repository, CancellationToken ct) =>
        TypedResults.Ok(await repository.GetAllAsync(ct));

    private static async Task<Results<Ok<Item>, NotFound>> GetById(Guid id, IItemRepository repository, CancellationToken ct) =>
        await repository.GetByIdAsync(id, ct) is { } item
            ? TypedResults.Ok(item)
            : TypedResults.NotFound();

    private static async Task<Created<Item>> Create(
        CreateItemRequest request,
        IItemRepository repository,
        TimeProvider clock,
        CancellationToken ct)
    {
        var item = new Item(Guid.CreateVersion7(), request.Name.Trim(), request.Description?.Trim(), clock.GetUtcNow());
        await repository.AddAsync(item, ct);
        // Relative Location: correct behind any proxy, and never derived from the client's Host header.
        return TypedResults.Created($"/api/__NAME__/items/{item.Id}", item);
    }
}
