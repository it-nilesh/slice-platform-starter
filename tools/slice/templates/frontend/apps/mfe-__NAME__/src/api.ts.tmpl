export interface Item {
  id: string;
  name: string;
  description: string | null;
  createdAt: string;
}

// Relative URL: always same-origin through the gateway, so no CORS is needed.
const BASE_URL = '/api/__NAME__/items';

export async function getItems(signal?: AbortSignal): Promise<Item[]> {
  const res = await fetch(BASE_URL, { signal, headers: { Accept: 'application/json' } });
  if (!res.ok) throw new Error(`__LABEL__ API responded ${res.status}`);
  return (await res.json()) as Item[];
}

export async function createItem(name: string, description: string): Promise<Item> {
  const res = await fetch(BASE_URL, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
    body: JSON.stringify({ name, description: description || null }),
  });
  if (!res.ok) {
    // ASP.NET Core returns RFC 9457 problem details on validation errors.
    const problem = (await res.json().catch(() => null)) as { title?: string } | null;
    throw new Error(problem?.title ?? `__LABEL__ API responded ${res.status}`);
  }
  return (await res.json()) as Item;
}
