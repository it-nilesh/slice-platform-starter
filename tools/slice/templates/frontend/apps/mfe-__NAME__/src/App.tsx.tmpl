import type { RemoteAppProps } from '@mfe/contracts';
import { useEffect, useId, useState, type FormEvent } from 'react';
import { createItem, getItems, type Item } from './api.ts';
import styles from './App.module.css';

export default function App(_props: RemoteAppProps) {
  const [items, setItems] = useState<Item[]>([]);
  const [status, setStatus] = useState<'loading' | 'ready' | 'error'>('loading');
  const [name, setName] = useState('');
  const [description, setDescription] = useState('');
  const [saving, setSaving] = useState(false);
  const [message, setMessage] = useState<string | null>(null);
  const nameId = useId();
  const descriptionId = useId();

  useEffect(() => {
    const controller = new AbortController();
    getItems(controller.signal)
      .then((data) => {
        setItems(data);
        setStatus('ready');
      })
      .catch(() => {
        if (!controller.signal.aborted) setStatus('error');
      });
    return () => controller.abort();
  }, []);

  const submit = async (e: FormEvent) => {
    e.preventDefault();
    setSaving(true);
    setMessage(null);
    try {
      const item = await createItem(name, description);
      setItems((current) => [item, ...current]);
      setName('');
      setDescription('');
      setMessage(`Created “${item.name}”.`);
    } catch (err) {
      setMessage(err instanceof Error ? err.message : 'Could not create the item.');
    } finally {
      setSaving(false);
    }
  };

  return (
    <section className={styles.root}>
      <header className={styles.header}>
        <h2>__LABEL__</h2>
        <span className={styles.badge}>mfe-__NAME__ → __NAME__-api</span>
      </header>

      <form className={styles.panel} onSubmit={submit}>
        <label htmlFor={nameId}>Name</label>
        <input id={nameId} required maxLength={100} value={name} onChange={(e) => setName(e.target.value)} />
        <label htmlFor={descriptionId}>Description (optional)</label>
        <input
          id={descriptionId}
          maxLength={500}
          value={description}
          onChange={(e) => setDescription(e.target.value)}
        />
        <div className={styles.actions}>
          <button type="submit" disabled={saving}>
            {saving ? 'Saving…' : 'Add item'}
          </button>
          {message && (
            <span role="status" aria-live="polite" className={styles.muted}>
              {message}
            </span>
          )}
        </div>
      </form>

      {status === 'loading' && <p role="status">Loading…</p>}
      {status === 'error' && (
        <p className={styles.error} role="alert">
          Could not load items. Is __NAME__-api running?
        </p>
      )}
      {status === 'ready' && items.length === 0 && <p className={styles.muted}>No items yet.</p>}

      <ul className={styles.list}>
        {items.map((item) => (
          <li key={item.id}>
            <strong>{item.name}</strong>
            {item.description && <span className={styles.muted}> · {item.description}</span>}
          </li>
        ))}
      </ul>
    </section>
  );
}
