import { federation } from '@module-federation/vite';
import react from '@vitejs/plugin-react';
import { defineConfig } from 'vite';

// Served by the gateway under /mfe/__NAME__/, so all asset URLs must carry that prefix.
const BASE = '/mfe/__NAME__/';
const DEV_PORT = __MFE_PORT__;
const API_TARGET = process.env.__UPPER___API_URL ?? 'http://localhost:__API_PORT__';

export default defineConfig({
  base: BASE,
  plugins: [
    federation({
      name: '__NAME__',
      filename: 'remoteEntry.js',
      exposes: {
        './App': './src/App.tsx',
      },
      shared: {
        react: { singleton: true },
        'react-dom': { singleton: true },
      },
      dts: false,
    }),
    react(),
  ],
  server: {
    port: DEV_PORT,
    strictPort: true,
    origin: `http://localhost:${DEV_PORT}`,
    cors: true,
    // Standalone dev only; behind the gateway, NGINX routes /api.
    proxy: { '/api/__NAME__': API_TARGET },
  },
  preview: { port: DEV_PORT, strictPort: true },
  build: { target: 'esnext' },
});
